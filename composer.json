{
    "name": "papi-ai/ingest-gitingest",
    "description": "Remote repository ingestion for PapiAI via the gitingest CLI",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Marcello Duarte",
            "email": "marcello.duarte@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "papi-ai/ingest": "^0.15"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "vimeo/psalm": "^6.0"
    },
    "suggest": {
        "papi-ai/ingest-php-symbols": "Symbol extraction for PHP, required for Depth::Api"
    },
    "autoload": {
        "psr-4": {
            "PapiAI\\Ingest\\Gitingest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PapiAI\\Ingest\\Gitingest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "XDEBUG_MODE=coverage pest --coverage --min=60",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyse": "psalm",
        "ci": [
            "@lint",
            "@analyse",
            "@test:coverage"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
